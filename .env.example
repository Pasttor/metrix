# Copia este archivo a .env.local y llena los valores. Nunca subas .env.local al repo.

# App
APP_URL=http://localhost:3000
ALLOWED_EMAIL=tu-correo@ejemplo.com   # valor real solo en .env.local y en Vercel
TOKEN_ENCRYPTION_KEY=          # 32 bytes en base64: openssl rand -base64 32
CRON_SECRET=                   # Vercel lo envía como "Authorization: Bearer <CRON_SECRET>" (mínimo 16 caracteres)
REPORT_TIMEZONE=America/Mexico_City

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=     # solo en el servidor

# Google / YouTube (requeridas desde T05)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
YOUTUBE_MONETARY=false         # true agrega el scope de ingresos

# Meta (requeridas desde T08)
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v26.0
META_LOGIN_CONFIG_ID=          # opcional: configuración de Facebook Login for Business
META_WEBHOOK_VERIFY_TOKEN=

# TikTok (requeridas desde T13)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Alertas (T16)
RESEND_API_KEY=
ALERT_EMAIL_TO=tu-correo@ejemplo.com
CONTACT_EMAIL=                 # opcional: correo de contacto público en /privacidad
ALERT_EMAIL_FROM=              # opcional: remitente de alertas (por defecto el remitente de prueba de Resend)
